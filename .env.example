# ── Admin access (server-only; never commit real values) ──
# Password checked by POST /api/admin/login (timing-safe compare).
ADMIN_PASSWORD=change-me-to-a-strong-password
# Bearer token required on all mutating /api routes + /admin/* pages.
# Generate with: openssl rand -hex 32
ADMIN_API_TOKEN=change-me-to-a-random-token

# ── Vercel Blob storage ──
# Private store token used by news/circulars/events/gallery APIs.
BLOB_READ_WRITE_TOKEN=change-me-to-your-blob-token
